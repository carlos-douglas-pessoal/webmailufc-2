    "@babel/cli": "^7.10.4",
    "@babel/core": "^7.10.4",
    "@babel/preset-env": "^7.10.4",
    "axios": "^0.19.2",
    "babel-plugin-import": "^1.13.0",
    "babel-plugin-module-alias": "^1.6.0",
    "babel-plugin-module-resolver": "^4.0.0",
    "babel-plugin-transform-import-css": "^1.0.0-alpha.11",
    "babel-plugin-transform-imports": "^2.0.0",
    "babelify": "^10.0.0",
    "browserify-css": "^0.15.0",
    "buefy": "^0.8.20",
    "css-modulesify": "^0.28.0",
    "envify": "^4.1.0",
    "jquery": "^3.5.1",
    "kebab-case": "^1.0.0",
    "lit-html": "^1.2.1",
    "lodash": "^4.17.19",
    "maz-ui": "^1.2.14",
    "node-sass": "^4.14.1",
    "portal-vue": "^2.1.7",
    "postcss-image-inliner": "^4.0.2",
    "postcss-inline-base64": "^5.0.0",
    "postcss-inline-svg": "^4.1.0",
    "postcss-url": "^8.0.0",
    "sass-loader": "^8.0.2",
