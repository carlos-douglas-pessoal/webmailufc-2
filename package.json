  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "css-build": "node-sass --omit-source-map-url static/styles.scss static/css/styles.css",
    "bundle": "set NODE_ENV=production&&browserify -p tinyify -e webmailufc/assets/js/app.js -g envify -r vue -r vee-validate -r buefy -r vue-select -r vue-phone-number-input -r vue-tour -r select2 -r axios > webmailufc/assets/js/bundle.js",
    "bundle2": "set NODE_ENV=production&&browserify webmailufc/assets/js/app.js -p tinyify -g envify node_modules/vue node_modules/vee-validate node_modules/buefy node_modules/vue-select node_modules/vue-phone-number-input node_modules/vue-tour node_modules/select2 node_modules/axios --standalone Bundle > bundle.js",
    "production": "set NODE_ENV=production&&browserify -t browserify-css -p tinyify -g envify webmailufc/assets/js/app.js -o webmailufc/assets/js/bundle.js",
    "watch": "watchify webmailufc/assets/js/app.js -v -o webmailufc/assets/js/bundle.js"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.dsi:33268/elano.melo/webmailufc.git"
  },
