  "browserify-css": {
    "autoInject": true,
    "minify": true,
    "rootDir": ".",
    "inlineImages": {
      "options": {
        "limit": 0
      }
    },
    "verbose": true
  },
  "browserify": {
    "transform": [
      [
        "babelify"
      ]
    ]
  }
